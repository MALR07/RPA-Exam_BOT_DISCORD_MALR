      "parameters": {
        "jsCode": "// Accedemos a la propiedad 'data' del nodo anterior\nconst data = $input.all()[0].json.data; \nconst seleccionadas = data[\"Selecciona tus especialidades\"] || [];\nconst resultados = []; // Este es nuestro \"lista\"\n\nseleccionadas.forEach(especialidad => {\n  // Vamos empujando cada objeto a nuestra lista\n  resultados.push({\n    json: {\n      \"Especialidad\": [especialidad], \n      \"Fecha\": data[`Fecha para ${especialidad}`] || null,\n      \"Hora\": data[`Hora para ${especialidad}`] || null\n    }\n  });\n});\n\n// ¡IMPORTANTE! Devolvemos el array completo\nreturn resultados;"
      },
      "type": "n8n-nodes-base.code",
